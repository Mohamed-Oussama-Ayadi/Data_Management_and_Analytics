  <MdxScripts>
    <MdxScript dwd:design-time-name="4856521a-62be-4db5-ad24-48a7b616f861">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].Cout_Total
 AS [Measures].[Cout Indirect]+[Measures].[Cout Direct Matiere]+[Measures].[Cout Direct Main Oeuvre], 
FORMAT_STRING = "Standard", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].Prix_Vente_Moyen
 AS [Measures].[CA]/[Measures].[Quantite], 
FORMAT_STRING = "Currency", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].PourcentageMarge
 AS [Measures].[Marge]/[Measures].[CA], 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE DYNAMIC SET CURRENTCUBE.[Top10_Clients]
 AS TOPCOUNT( [Dim Client].[Client].[Client], 10, [Measures].[CA] ) ; 
CREATE DYNAMIC SET CURRENTCUBE.[Top5_Produits]
 AS TOPCOUNT( [Dim Produit].[Produit].[Produit], 5, [Measures].[CA] ) ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="2bbe4677-bce3-402c-a9fa-01efedd3ec4b">
      <ID>KPI</ID>
      <Name>KPI_CA</Name>
      <Value>[Measures].[CA]</Value>
      <Goal>50000000</Goal>
      <Status>CASE 
when KPIVALUE( "KPI_CA" )&gt;0.9*KPIGOAL( "KPI_CA" )
THEN 1
when KPIVALUE( "KPI_CA" )&lt;=0.9*KPIGOAL( "KPI_CA" )
and KPIVALUE( "KPI_CA" )&gt;0.6*KPIGOAL( "KPI_CA" )
THEN 0
else -1
end</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>