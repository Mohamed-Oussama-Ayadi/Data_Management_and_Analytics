  <MdxScripts>
    <MdxScript dwd:design-time-name="4f293c79-7f8f-4688-9939-bde1e410be70">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].Consommation_sucre
 AS [Measures].[Nbr Sucre]*2, 
VISIBLE = 1  ; 
CREATE DYNAMIC SET CURRENTCUBE.[Top3produit]
 AS TOPCOUNT( [Dim Produits].[PRODUIT], 3, [Measures].[PRIX] ) ; 
CREATE DYNAMIC SET CURRENTCUBE.[TopCategorie]
 AS TOPCOUNT([Dim Produits].[ID Categorie], 1,[Measures].[PRIX] ) ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
